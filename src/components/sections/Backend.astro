---
import { projects } from '@/data/projects';
import { getTech } from '@/data/stack';
import type { Lang } from '@/data/profile';
import Doodle from '@/components/ui/Doodle.astro';
import TechIcon from '@/components/ui/TechIcon.astro';
import { backendCopy } from '@/i18n/sections/backend';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = backendCopy[lang];

const items = projects.filter((p) => p.backend && p.highlights?.length);
const rotations = ['-0.8deg', '0.7deg', '0.5deg', '-0.6deg', '0.9deg', '-0.4deg'];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="backend" class="backend mx-auto max-w-7xl px-6 py-32" aria-labelledby="backend-title">
  <header class="mb-16 grid items-end gap-8 md:grid-cols-12">
    <div class="reveal relative md:col-span-8">
      <p class="mono mb-5 text-sm text-muted">{c.eyebrow}</p>
      <h2 id="backend-title" class="display text-5xl font-bold md:text-7xl">
        {c.title.before}<span class="serif-accent relative inline-block font-normal">
          {c.title.accent}
          <Doodle kind="squiggle" class="absolute -bottom-3 left-0 w-full text-accent" />
        </span>
      </h2>
    </div>
    <p class="reveal text-lg leading-relaxed text-muted md:col-span-4">{c.intro}</p>
  </header>

  <ul class="grid gap-8 md:grid-cols-2">
    {items.map((p, i) => (
      <li class="reveal">
        <article class="note bk-card h-full p-7 md:p-8" style={`--r:${rotations[i % rotations.length]}`} aria-labelledby={`bk-${p.slug}`}>
          <div class="flex items-start justify-between gap-4">
            <p class="mono text-xs text-muted">
              <span aria-hidden="true">{pad(i + 1)}</span>
              <span class="dot-sep" aria-hidden="true"></span>{p.kind[lang]}<span class="dot-sep" aria-hidden="true"></span>{p.year}
            </p>
            {p.client && <span class="bk-tag mono">Freelance</span>}
          </div>

          <h3 id={`bk-${p.slug}`} class="display mt-4 text-3xl font-bold md:text-4xl">{p.title}</h3>
          <p class="mt-4 leading-relaxed text-muted">{p.summary[lang]}</p>

          <p class="mono mt-6 text-xs text-muted">{c.highlightsLabel}</p>
          <ul class="mt-3 space-y-2.5">
            {p.highlights?.map((h) => (
              <li class="bk-fact flex gap-3 text-sm leading-relaxed">
                <span class="bk-mark mono" aria-hidden="true">→</span>
                <span>{h[lang]}</span>
              </li>
            ))}
          </ul>

          <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-3" aria-label="Stack">
            {p.stack.map((id) => (
              <li class="group inline-flex items-center gap-2 text-sm">
                <TechIcon id={id} size={20} mono />
                <span>{getTech(id)?.name ?? id}</span>
              </li>
            ))}
          </ul>

          <div class="mt-7 flex flex-wrap items-center gap-4 text-sm">
            {p.links.repo ? (
              <a class="bk-link mono" href={p.links.repo} target="_blank" rel="noopener noreferrer">{c.viewCode} <span aria-hidden="true">↗</span></a>
            ) : (
              <span class="mono text-muted">{c.privateCode}</span>
            )}
            {p.case && <a class="bk-link mono" href={`#case-${p.slug}`}>{c.seeCase} <span aria-hidden="true">↑</span></a>}
          </div>
        </article>
      </li>
    ))}
  </ul>
  <p class="mono mt-8 text-xs text-muted">{c.factsNote}</p>
</section>

<style>
  .bk-card {
    transform: rotate(var(--r, 0deg));
  }
  .bk-card:hover {
    transform: rotate(0deg) translate(-2px, -2px);
  }
  .bk-tag {
    flex-shrink: 0;
    border: 1px dashed var(--ink);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.7rem;
  }
  .bk-mark {
    color: var(--accent-text);
    flex-shrink: 0;
  }
  .bk-link {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    transition: color 0.2s ease;
  }
  .bk-link:hover {
    color: var(--accent-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .bk-card,
    .bk-card:hover {
      transform: none;
    }
  }
</style>
