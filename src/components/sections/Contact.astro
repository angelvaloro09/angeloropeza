---
import { profile } from '@/data/profile';
import { t } from '@/i18n/ui';
import { contactCopy } from '@/i18n/sections/contact';
import Avatar from '@/components/ui/Avatar.astro';
import Doodle from '@/components/ui/Doodle.astro';
import type { Lang } from '@/data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const copy = contactCopy[lang];
const currentYear = new Date().getFullYear();
---

<section id="contact" class="mx-auto max-w-7xl px-6 pb-16 pt-[var(--section-y)]">
  <!-- Prompt header -->
  <div class="reveal mb-6 sm:mb-8">
    <h2 class="display h-contact font-bold tracking-tight text-[var(--ink)]">
      <span class="serif-accent font-normal italic text-[var(--accent)]">{tr.contact}</span>
    </h2>
    <p class="mt-3 text-base sm:text-lg text-[var(--muted)] max-w-xl font-normal">
      {copy.subtitle}
    </p>
  </div>

  <!-- Giant Mailto Link with Animated Hand-drawn Squiggle Doodle -->
  <div class="reveal my-8 sm:my-12">
    <div class="contact-email-group group inline-block max-w-full">
      <a
        href={`mailto:${profile.email}`}
        class="contact-email-link display block font-bold text-[clamp(1.25rem,6.4vw,5.5rem)] text-[var(--ink)] tracking-tight break-words break-all sm:break-normal transition-colors duration-200 group-hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-[var(--accent)] focus-visible:outline-offset-4"
      >
        {profile.email}
      </a>
      <div class="mt-1 sm:mt-2 w-full max-w-md overflow-hidden" aria-hidden="true">
        <Doodle
          kind="squiggle"
          stroke="var(--accent)"
          class="contact-squiggle w-full h-5 sm:h-7 origin-left"
        />
      </div>
    </div>

    <!-- Quick action: Copy email to clipboard -->
    <div class="mt-6 flex items-center gap-4 flex-wrap">
      <button
        id="copy-email-btn"
        type="button"
        data-email={profile.email}
        data-copied={copy.copied}
        data-default={copy.copyEmail}
        aria-label={copy.copyEmail}
        class="mono text-xs sm:text-sm font-medium px-4 py-2.5 min-h-[44px] min-w-[44px] rounded-full border border-[var(--ink)] bg-[var(--surface)] text-[var(--ink)] hover:bg-[var(--accent-soft)] hover:border-[var(--accent)] transition-all duration-200 inline-flex items-center gap-2 cursor-pointer shadow-[2px_2px_0_var(--ink)] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[3px_3px_0_var(--ink)] active:translate-x-[1px] active:translate-y-[1px] active:shadow-[1px_1px_0_var(--ink)]"
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span id="copy-email-text">{copy.copyEmail}</span>
      </button>
      <span id="copy-status" role="status" aria-live="polite" class="sr-only"></span>
    </div>
  </div>

  <!-- Social links and Peeking Avatar cluster -->
  <div class="reveal mt-12 sm:mt-16 flex flex-col md:flex-row md:items-end justify-between gap-10">
    <!-- Outlined pill buttons for GitHub & LinkedIn -->
    <div class="flex flex-wrap items-center gap-3 sm:gap-4">
      <a
        href={profile.github}
        target="_blank"
        rel="noopener"
        aria-label={copy.githubLabel}
        class="mono text-xs sm:text-sm font-medium px-5 py-3 min-h-[44px] rounded-full border border-[var(--ink)] bg-[var(--surface)] text-[var(--ink)] shadow-[2px_2px_0_var(--ink)] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[4px_4px_0_var(--ink)] hover:text-[var(--accent)] transition-all duration-200 inline-flex items-center gap-2"
      >
        <span>GitHub</span>
        <span class="inline-block transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
      </a>

      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener"
        aria-label={copy.linkedinLabel}
        class="mono text-xs sm:text-sm font-medium px-5 py-3 min-h-[44px] rounded-full border border-[var(--ink)] bg-[var(--surface)] text-[var(--ink)] shadow-[2px_2px_0_var(--ink)] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[4px_4px_0_var(--ink)] hover:text-[var(--accent)] transition-all duration-200 inline-flex items-center gap-2"
      >
        <span>LinkedIn</span>
        <span class="inline-block transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
      </a>
    </div>

    <!-- Small Avatar peeking from the bottom/side with a Doodle -->
    <div class="relative self-start md:self-auto flex items-center gap-4 pt-2">
      <div class="relative">
        <!-- Hand-drawn arrow doodle pointing to avatar/socials -->
        <div class="absolute -top-7 -left-7 pointer-events-none" aria-hidden="true">
          <Doodle kind="arrow" stroke="var(--accent)" class="w-8 h-6 -rotate-12" />
        </div>

        <!-- Rotated peeking avatar sticker -->
        <div class="peeking-avatar-wrapper">
          <Avatar
            size={150}
            lang={lang}
            class="shadow-[3px_3px_0_var(--ink)]"
          />
        </div>

        <!-- Small asterisk doodle at corner -->
        <div class="absolute -bottom-3 -right-3 pointer-events-none" aria-hidden="true">
          <Doodle kind="asterisk" stroke="var(--ink)" class="w-5 h-5" />
        </div>
      </div>

      <div class="mono text-xs text-[var(--muted)] max-w-[130px] leading-tight select-none">
        <p>{copy.avatarNote}</p>
      </div>
    </div>
  </div>

  <!-- Footer line -->
  <footer class="mono mt-20 sm:mt-28 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-[var(--line)] pt-8 text-xs text-[var(--muted)]">
    <div class="flex items-center gap-2 flex-wrap text-center sm:text-left">
      <span>© {currentYear} {profile.name}</span>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <span>{tr.footer}</span>
    </div>

    <a
      href="#site-header"
      class="min-h-[44px] px-3 py-2 inline-flex items-center gap-1.5 text-[var(--muted)] hover:text-[var(--ink)] focus-visible:outline-2 focus-visible:outline-[var(--accent)] transition-colors"
    >
      <span>{copy.backToTop}</span>
    </a>
  </footer>
</section>

<style>
  .contact-squiggle {
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .contact-email-group:hover .contact-squiggle,
  .contact-email-link:focus-visible ~ div .contact-squiggle {
    transform: scaleX(1.06) translateY(-2px);
  }

  .peeking-avatar-wrapper {
    transform: rotate(2deg);
    transition: transform 0.3s ease;
  }

  .peeking-avatar-wrapper:hover {
    transform: rotate(0deg) scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-squiggle,
    .contact-email-group:hover .contact-squiggle,
    .peeking-avatar-wrapper,
    .peeking-avatar-wrapper:hover {
      animation: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function setupCopyEmail() {
    const btn = document.getElementById('copy-email-btn');
    const textEl = document.getElementById('copy-email-text');
    const statusEl = document.getElementById('copy-status');

    if (!btn || !textEl || !statusEl) return;

    let timeoutId: number | undefined;

    btn.addEventListener('click', async () => {
      const email = btn.dataset.email;
      const copiedText = btn.dataset.copied || 'Copied!';
      const defaultText = btn.dataset.default || 'Copy email';

      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        textEl.textContent = copiedText;
        statusEl.textContent = copiedText;

        if (timeoutId) clearTimeout(timeoutId);
        timeoutId = window.setTimeout(() => {
          textEl.textContent = defaultText;
          statusEl.textContent = '';
        }, 2200);
      } catch {
        statusEl.textContent = email;
      }
    });
  }

  document.addEventListener('astro:page-load', setupCopyEmail);
</script>
