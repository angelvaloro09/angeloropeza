---
import { profile, projects, skills } from '@/data/profile';
import { t } from '@/i18n/ui';
import type { Lang } from '@/data/profile';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const techCount = new Set(skills.flatMap((s) => s.items)).size;
---
<section class="relative flex min-h-screen flex-col justify-center overflow-hidden px-6 pt-32">
  <div aria-hidden="true" class="pointer-events-none absolute -right-40 top-1/4 h-[560px] w-[560px] rounded-full opacity-40 blur-3xl"
       style="background: radial-gradient(circle, var(--accent), transparent 65%)"></div>
  <div class="relative mx-auto w-full max-w-7xl">
    <p class="mono mb-6 text-sm" style="color: var(--muted)">{profile.role[lang]} · {profile.location}</p>
    <h1 class="display text-[clamp(3.5rem,13vw,11rem)] font-bold">{profile.name}</h1>
    <p class="mt-8 max-w-2xl text-lg md:text-xl" style="color: var(--muted)">{profile.tagline[lang]}</p>
    <a href="#work" class="mono mt-10 inline-block rounded-full px-7 py-3 text-sm text-white" style="background: var(--accent)">{tr.hero.cta} ↓</a>

    <div class="mt-20 grid max-w-3xl grid-cols-3 gap-4">
      <div class="card p-5"><div class="display text-4xl font-bold" data-count={projects.length}>{projects.length}</div><div class="mono mt-2 text-xs" style="color: var(--muted)">{tr.metrics.projects}</div></div>
      <div class="card p-5"><div class="display text-4xl font-bold" data-count={techCount}>{techCount}</div><div class="mono mt-2 text-xs" style="color: var(--muted)">{tr.metrics.langs}</div></div>
      <div class="card p-5"><div class="display text-4xl font-bold" data-count="2">2</div><div class="mono mt-2 text-xs" style="color: var(--muted)">{tr.metrics.years}</div></div>
    </div>
  </div>
</section>
