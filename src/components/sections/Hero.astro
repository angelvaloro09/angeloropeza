---
import { profile, techList } from '@/data/profile';
import type { Lang } from '@/data/profile';
import { heroCopy } from '@/i18n/sections/hero';
import Avatar from '@/components/ui/Avatar.astro';
import Doodle from '@/components/ui/Doodle.astro';
import Marquee from '@/components/ui/Marquee.astro';
import TechIcon from '@/components/ui/TechIcon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;
const copy = heroCopy[lang];

const [firstName, ...restName] = profile.name.split(' ');
const lastName = restName.join(' ');

// Marker highlight on one key phrase of the tagline (phrase lives in the i18n file).
const tagline = profile.tagline[lang];
const at = tagline.indexOf(copy.marker);
const [before, marked, after] =
  at >= 0
    ? [tagline.slice(0, at), copy.marker, tagline.slice(at + copy.marker.length)]
    : [tagline, '', ''];
---

<div class="hero-shell">
<section data-hero class="hero relative overflow-x-clip px-6">
  <div class="hero-grid mx-auto grid w-full max-w-7xl items-center">
    <!-- Copy -->
    <div class="relative">
      <p data-hero-in class="hero-role mono text-sm md:text-base" style="color: var(--muted)">
        {profile.role[lang]}<span class="dot-sep"></span>{profile.location}
      </p>

      <h1 class="hero-title display font-bold">
        <span data-hero-in class="block">{firstName}</span>{' '}
        {lastName && (
          <span data-hero-in class="serif-accent block" style="font-weight:400;font-size:1.08em;letter-spacing:-0.02em;padding-left:0.08em">
            {lastName}<span class="hero-dot" aria-hidden="true">.</span>
          </span>
        )}
      </h1>

      <p data-hero-in class="hero-tagline max-w-xl leading-relaxed" style="color: var(--muted)">
        {before}{marked && <span class="marker hero-marker" style="color: var(--ink)">{marked}</span>}{after}
      </p>

      <div data-hero-in class="hero-actions flex flex-wrap items-center gap-4">
        <a href="#work" class="hero-cta hero-cta-primary mono">
          {copy.ctaWork}<span aria-hidden="true"> ↓</span>
        </a>
        <a href="#contact" class="hero-cta hero-cta-secondary mono">
          {copy.ctaContact}<span aria-hidden="true"> →</span>
        </a>
      </div>

      <div data-hero-in class="hero-scroll mono hidden items-center gap-3 text-xs md:flex" style="color: var(--muted)" aria-hidden="true">
        <span class="hero-wheel"></span>
        <span>{copy.scroll}</span>
      </div>
    </div>

    <!-- Avatar + doodles -->
    <div class="hero-art relative mx-auto w-full lg:-mr-8">
      <!-- hand-written greeting + arrow pointing at the avatar -->
      <div data-hero-doodle class="absolute left-0 top-0 flex items-end gap-1 lg:left-4" aria-hidden="true">
        <span class="serif-accent text-3xl md:text-4xl" style="color: var(--ink); transform: rotate(-6deg)">{copy.greeting}</span>
        <Doodle kind="arrow" class="mb-1 h-8 w-12 rotate-[24deg]" />
      </div>

      <div data-hero-avatar class="ml-auto w-fit -rotate-2">
        <Avatar size="var(--hero-avatar)" lang={lang} />
      </div>

      <div data-hero-doodle class="absolute right-0 top-6 text-accent lg:right-4" aria-hidden="true">
        <Doodle kind="asterisk" class="h-10 w-10 rotate-12 md:h-14 md:w-14" />
      </div>
      <div data-hero-doodle class="absolute -bottom-4 left-4 lg:left-10" aria-hidden="true">
        <Doodle kind="squiggle" class="h-5 w-28 -rotate-6 md:w-36" />
      </div>
      <div data-hero-doodle class="absolute -bottom-2 right-2 hidden md:block lg:right-8" aria-hidden="true">
        <Doodle kind="asterisk" class="h-6 w-6 -rotate-12" />
      </div>
    </div>
  </div>
</section>

<!-- Tech marquee: full-bleed band, pauses on hover / focus -->
<div class="tech-band">
  <Marquee label={copy.techLabel} duration={70} gap="3rem" class="py-5">
    {techList.map((tech) => (
      <span class="group tech-chip mono">
        <TechIcon id={tech.id} size={24} mono />
        <span>{tech.name}</span>
      </span>
    ))}
  </Marquee>
</div>
</div>

<style>
  /* Hero + tech band = one block that always fills the first viewport (svh = small viewport,
     so mobile browser chrome never pushes content out). Band is pinned to the bottom. */
  .hero-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }

  .hero {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-h) + clamp(0.25rem, 2svh, 2.5rem));
    padding-bottom: clamp(1.5rem, 4svh, 4rem);
    /* avatar scales with the smaller of width / height so it never outgrows the first view */
    --hero-avatar: clamp(8rem, min(62vw, 28vh), 27.5rem);
    --hero-avatar: clamp(8rem, min(62vw, 28svh), 27.5rem);
  }

  .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.5rem, 3svh, 2.5rem);
  }

  .hero-role {
    margin-bottom: clamp(0.75rem, 2.5svh, 1.5rem);
  }

  .hero-title {
    font-size: clamp(2.75rem, min(12vw, 15vh), 10rem);
    font-size: clamp(2.75rem, min(12vw, 15svh), 10rem);
  }

  .hero-tagline {
    margin-top: clamp(0.75rem, 3svh, 2rem);
    font-size: var(--step-1);
  }

  .hero-actions {
    margin-top: clamp(1rem, 3.5svh, 2.5rem);
  }

  .hero-scroll {
    margin-top: clamp(1.5rem, 5svh, 3.5rem);
  }

  .hero-art {
    max-width: 26rem;
    padding-top: clamp(2.25rem, 6svh, 3.5rem);
  }

  /* short portrait phones (e.g. 360x640): spend less height on the avatar so the band peeks in */
  @media (max-height: 700px) and (max-width: 639px) {
    .hero {
      --hero-avatar: clamp(8rem, min(62vw, 23vh), 27.5rem);
      --hero-avatar: clamp(8rem, min(62vw, 23svh), 27.5rem);
    }
    .hero-art {
      padding-top: 2rem;
    }
  }

  /* two columns: desktop width, or landscape phones (wide but short) */
  @media (min-width: 1024px), (min-width: 640px) and (max-height: 520px) and (orientation: landscape) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      column-gap: 1.5rem;
    }
    .hero-art {
      max-width: none;
    }
    .hero {
      --hero-avatar: clamp(8rem, min(36vw, 48vh), 27.5rem);
      --hero-avatar: clamp(8rem, min(36vw, 48svh), 27.5rem);
    }
  }

  .hero-dot {
    color: var(--accent);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em; /* flex collapses the leading space of the arrow span */
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    padding: 0.85rem 1.6rem;
    font-size: 0.9rem;
    line-height: 1;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease, background-color 0.2s ease;
  }

  /* ≥44px touch target (0.85rem*2 padding + 0.9rem text + 3px border); tighter sides keep both CTAs on one row at 360px */
  @media (max-width: 400px) {
    .hero-cta {
      padding-inline: 1.25rem;
    }
  }

  /* landscape phones: no room for the scroll hint, and the CTA row must stay inside the first view */
  @media (max-height: 520px) and (orientation: landscape) {
    .hero-scroll {
      display: none;
    }
    .hero-actions {
      margin-top: 0.75rem;
    }
    .hero-tagline {
      margin-top: 0.5rem;
      font-size: var(--step-0);
    }
  }

  .hero-cta-primary {
    background: var(--ink);
    color: var(--bg);
    box-shadow: 4px 4px 0 var(--accent);
  }

  .hero-cta-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--accent);
  }

  .hero-cta-primary:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--accent);
  }

  .hero-cta-secondary {
    background: transparent;
    color: var(--ink);
  }

  .hero-cta-secondary:hover {
    background: var(--surface);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .hero-cta-secondary:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }

  /* scroll hint: tiny mouse wheel, looping translateY */
  .hero-wheel {
    position: relative;
    display: inline-block;
    width: 22px;
    height: 34px;
    border: 1.5px solid var(--ink);
    border-radius: 12px;
  }

  .hero-wheel::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    width: 3px;
    height: 7px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--ink);
    animation: hero-wheel 1.8s ease-in-out infinite;
  }

  @keyframes hero-wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    60% {
      transform: translateY(11px);
      opacity: 0;
    }
    61% {
      transform: translateY(0);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* tech marquee band */
  .tech-band {
    border-block: 1.5px solid var(--ink);
    background: var(--surface);
  }

  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wheel::after {
      animation: none;
    }
    .hero-cta {
      transition: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  function initHero() {
    const root = document.querySelector<HTMLElement>('[data-hero]');
    if (!root || root.dataset.heroInit === '1') return;
    root.dataset.heroInit = '1';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const items = root.querySelectorAll<HTMLElement>('[data-hero-in]');
    const avatar = root.querySelector<HTMLElement>('[data-hero-avatar]');
    const doodles = root.querySelectorAll<HTMLElement>('[data-hero-doodle]');
    const marker = root.querySelector<HTMLElement>('.hero-marker');

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.from(items, {
      y: 40,
      opacity: 0,
      duration: 0.9,
      stagger: 0.12,
      clearProps: 'transform,opacity',
    });

    if (avatar) {
      // settles from a slight extra rotation; the resting tilt comes from CSS (`rotate`)
      tl.from(
        avatar,
        { rotation: 7, y: 30, opacity: 0, duration: 1.1, ease: 'back.out(1.4)', clearProps: 'transform,opacity' },
        0.25,
      );
    }

    if (doodles.length) {
      tl.from(
        doodles,
        { scale: 0, opacity: 0, duration: 0.5, stagger: 0.12, ease: 'back.out(2)', clearProps: 'transform,opacity' },
        0.9,
      );
    }

    if (marker) {
      tl.fromTo(
        marker,
        { backgroundSize: '0% 40%' },
        { backgroundSize: '100% 40%', duration: 0.7, ease: 'power2.out', clearProps: 'backgroundSize' },
        1.0,
      );
    }
  }

  document.addEventListener('astro:page-load', initHero);
</script>
