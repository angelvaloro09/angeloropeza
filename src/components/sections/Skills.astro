---
import { skills } from '@/data/profile';
import { t } from '@/i18n/ui';
import type { Lang } from '@/data/profile';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
---
<section id="stack" class="mx-auto max-w-7xl px-6 py-32">
  <h2 class="display reveal mb-16 text-5xl font-bold md:text-7xl">{tr.stack}</h2>
  <div class="grid gap-4 md:grid-cols-3">
    {skills.map((g) => (
      <div class="card reveal p-6">
        <h3 class="mono mb-4 text-sm" style="color: var(--glow)">{g.group[lang]}</h3>
        <ul class="flex flex-wrap gap-2">
          {g.items.map((i) => <li class="rounded-lg border px-3 py-1.5 text-sm" style="border-color: var(--line)">{i}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
