---
import { timeline } from '@/data/profile';
import { t } from '@/i18n/ui';
import { pathCopy } from '@/i18n/sections/path';
import Doodle from '@/components/ui/Doodle.astro';
import type { Lang } from '@/data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const copy = pathCopy[lang];

const rotations = ['-0.75deg', '0.6deg', '-0.5deg', '0.75deg'];
---

<section id="path" class="mx-auto max-w-7xl px-6 py-24 sm:py-32">
  <div class="reveal mb-12 sm:mb-16">
    <p class="mono mb-3 text-xs uppercase tracking-widest text-[var(--muted)]">
      {tr.path}
    </p>
    <h2 class="display text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight text-[var(--ink)]">
      {copy.sectionTitlePrefix} <span class="serif-accent font-normal italic text-[var(--accent)]">{copy.sectionTitleAccent}</span>
    </h2>
    <p class="mt-4 max-w-xl text-base sm:text-lg text-[var(--muted)] font-normal">
      {copy.lead}
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    <div class="lg:col-span-8">
      <div class="relative">
        <!-- Wobbled vertical ink line -->
        <div class="timeline-line-track absolute left-4 sm:left-6 top-3 bottom-3 w-4 -translate-x-1/2 pointer-events-none" aria-hidden="true">
          <svg
            class="w-full h-full overflow-visible"
            viewBox="0 0 20 1000"
            preserveAspectRatio="none"
            fill="none"
          >
            <path
              id="timeline-path-line"
              d="M 10,0 C 7,160 13,320 8,480 C 12,640 8,800 12,920 L 10,1000"
              stroke="var(--ink)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
              pathLength="1"
            />
          </svg>
          <!-- Doodle at top end -->
          <div class="absolute -top-5 left-1/2 -translate-x-1/2" aria-hidden="true">
            <Doodle kind="asterisk" stroke="var(--accent)" class="w-4 h-4 sm:w-5 sm:h-5" />
          </div>
          <!-- Doodle at bottom end -->
          <div class="absolute -bottom-6 left-1/2 -translate-x-1/2" aria-hidden="true">
            <Doodle kind="arrow" stroke="var(--ink)" class="w-5 h-5 sm:w-6 sm:h-6 rotate-90" />
          </div>
        </div>

        <!-- Timeline list -->
        <ol class="relative list-none m-0 p-0 space-y-8 sm:space-y-12">
          {timeline.map((entry, index) => {
            const isBase = entry.place.toLowerCase().includes('base');
            const rotation = rotations[index % rotations.length];
            return (
              <li class="reveal relative pl-10 sm:pl-14">
                <!-- Marker pin on the line -->
                <span
                  class="timeline-dot absolute left-4 sm:left-6 -translate-x-1/2 top-6 w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full border-2 border-[var(--ink)] bg-[var(--surface)] z-10 transition-transform duration-200"
                  aria-hidden="true"
                >
                  <span class="block w-1.5 h-1.5 m-[1px] sm:m-[1.5px] rounded-full bg-[var(--accent)]" />
                </span>

                <!-- Sticky note card -->
                <article
                  class="note timeline-note p-5 sm:p-7"
                  style={`--r: ${rotation};`}
                >
                  <div class="flex items-center justify-between gap-2 flex-wrap mb-2">
                    <span class="mono text-xs sm:text-sm font-semibold tracking-wider text-[var(--accent-text)]">
                      {entry.year}
                    </span>
                    <span class="mono text-xs text-[var(--muted)] opacity-70">
                      0{index + 1}
                    </span>
                  </div>

                  <h3 class="display text-2xl sm:text-3xl lg:text-4xl font-bold text-[var(--ink)] tracking-tight">
                    {entry.title[lang]}
                  </h3>

                  <p class="mt-2 text-sm sm:text-base text-[var(--muted)] font-medium">
                    {entry.place}
                  </p>

                  {isBase && (
                    <div class="mt-4 pt-3 border-t border-[var(--line)]">
                      <p class="mono text-xs text-[var(--muted)] flex items-center gap-1.5">
                        <span class="text-[var(--accent)] font-bold" aria-hidden="true">✦</span>
                        <span>{copy.baseCredit}</span>
                      </p>
                    </div>
                  )}
                </article>
              </li>
            );
          })}
        </ol>
      </div>
    </div>

    <!-- Right column on desktop: sketchbook field notes -->
    <aside class="hidden lg:block lg:col-span-4 sticky top-28 space-y-6">
      <div class="note p-6" style="--r: 0.5deg;">
        <div class="flex items-center justify-between mb-4">
          <span class="mono text-xs font-semibold uppercase tracking-wider text-[var(--accent-text)]">
            {copy.noteBadge}
          </span>
          <Doodle kind="asterisk" stroke="var(--accent)" class="w-5 h-5" />
        </div>
        <h3 class="display text-xl font-bold text-[var(--ink)] mb-2">
          {copy.noteTitle}
        </h3>
        <p class="text-sm text-[var(--muted)] leading-relaxed">
          {copy.noteText}
        </p>
        <div class="mt-5 pt-4 border-t border-[var(--line)]">
          <p class="mono text-xs text-[var(--muted)] leading-normal flex items-start gap-1.5">
            <span class="text-[var(--accent)] font-bold shrink-0 mt-0.5" aria-hidden="true">✦</span>
            <span>{copy.baseCredit}</span>
          </p>
        </div>
      </div>

      <div class="px-4 py-2 flex items-center justify-center opacity-40" aria-hidden="true">
        <Doodle kind="scribble" stroke="var(--ink)" class="w-32 h-6" />
      </div>
    </aside>
  </div>

  <!-- Mobile footer credit -->
  <div class="mt-12 lg:hidden pt-6 border-t border-[var(--line)]">
    <p class="mono text-xs text-[var(--muted)] text-center flex items-center justify-center gap-1.5">
      <span class="text-[var(--accent)] font-bold" aria-hidden="true">✦</span>
      <span>{copy.baseCredit}</span>
    </p>
  </div>
</section>

<style>
  .timeline-note {
    transform: rotate(var(--r, -0.6deg));
  }

  .timeline-note:hover {
    transform: rotate(0deg) translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  #timeline-path-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-note,
    .timeline-note:hover {
      transform: none !important;
    }
    #timeline-path-line {
      stroke-dashoffset: 0 !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  let scrollTriggerInstance: ScrollTrigger | null = null;

  function setupTimelineLine() {
    if (scrollTriggerInstance) {
      scrollTriggerInstance.kill();
      scrollTriggerInstance = null;
    }

    const line = document.getElementById('timeline-path-line') as SVGPathElement | null;
    const pathSection = document.getElementById('path');

    if (!line || !pathSection) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      line.style.strokeDashoffset = '0';
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    line.style.strokeDasharray = '1';
    line.style.strokeDashoffset = '1';

    const tween = gsap.fromTo(
      line,
      { strokeDashoffset: 1 },
      {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: pathSection,
          start: 'top 70%',
          end: 'bottom 85%',
          scrub: 0.5,
        },
      }
    );

    if (tween.scrollTrigger) {
      scrollTriggerInstance = tween.scrollTrigger;
    }
  }

  document.addEventListener('astro:page-load', setupTimelineLine);
</script>
