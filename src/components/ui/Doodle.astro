---
export type DoodleKind = 'squiggle' | 'asterisk' | 'scribble' | 'rect' | 'arrow' | 'underline';

interface Props {
  kind: DoodleKind;
  stroke?: string;
  class?: string;
}

const { kind, stroke = 'currentColor', class: className = '' } = Astro.props;
---

{kind === 'squiggle' && (
  <svg
    viewBox="0 0 100 20"
    fill="none"
    stroke={stroke}
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class:list={['inline-block overflow-visible', className]}
  >
    <path d="M 4,11 C 18,3 26,17 40,9 C 54,2 62,18 76,10 C 86,4 93,13 96,10" />
  </svg>
)}

{kind === 'asterisk' && (
  <svg
    viewBox="0 0 32 32"
    fill="none"
    stroke={stroke}
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class:list={['inline-block overflow-visible', className]}
  >
    <path d="M 16,4 C 15.6,12 16.3,20 16,28" />
    <path d="M 5.5,10.5 C 12,14 19.5,17.5 26.5,21.5" />
    <path d="M 6,22 C 12.5,18 20,13.5 26,9.5" />
  </svg>
)}

{kind === 'scribble' && (
  <svg
    viewBox="0 0 120 30"
    fill="none"
    stroke={stroke}
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class:list={['inline-block overflow-visible', className]}
  >
    <path d="M 6,18 C 24,9 45,24 68,14 C 84,6 102,22 116,13" />
    <path d="M 12,22 C 30,16 55,25 78,18 C 94,12 107,19 114,17" />
  </svg>
)}

{kind === 'rect' && (
  <svg
    viewBox="0 0 120 50"
    fill="none"
    stroke={stroke}
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class:list={['inline-block overflow-visible', className]}
  >
    <path d="M 8,12 C 38,8 82,9 113,11 C 116,23 115,36 113,43 C 82,45 40,44 7,42 C 5,31 6,18 8,10 C 22,8 40,9 56,11" />
  </svg>
)}

{kind === 'arrow' && (
  <svg
    viewBox="0 0 60 40"
    fill="none"
    stroke={stroke}
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class:list={['inline-block overflow-visible', className]}
  >
    <path d="M 6,28 C 18,14 34,10 52,18" />
    <path d="M 40,12 C 46,15 49,17 53,19 C 49,24 46,29 44,34" />
  </svg>
)}

{kind === 'underline' && (
  <svg
    viewBox="0 0 120 16"
    fill="none"
    stroke={stroke}
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class:list={['inline-block overflow-visible', className]}
  >
    <path d="M 4,9 C 32,14 68,13 94,8 C 104,6 112,8 116,10" />
  </svg>
)}
